# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# `log` writes the message to storage/logs/laravel.log instead of sending it.
# That is the right default for a fresh checkout with no mail account, and the
# wrong one for anything that needs a real link delivered — the staff password
# reset is the case that bites: the flow reports "check your inbox" while the
# email has only ever been written to a log file.
#
# For local development, Mailtrap (https://mailtrap.io) is a safe sandbox: it
# catches everything without delivering to anyone's real inbox. Create a free
# inbox, copy its SMTP credentials below, then:
#
#     php artisan config:clear
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null          # null for plain SMTP; `smtps` for implicit TLS
#   MAIL_HOST=smtp.mailtrap.io
#   MAIL_PORT=2525            # 587 with STARTTLS, or 465 for implicit TLS
#   MAIL_USERNAME=            # your Mailtrap username
#   MAIL_PASSWORD=            # your Mailtrap password
#
# The credentials are deliberately empty here. They belong in .env, which is
# git-ignored, and never in a committed file.
#
# PRODUCTION: GMAIL
#
# The salon sends over Gmail's SMTP relay. Gmail will not accept the account's
# normal password — it requires an App Password, which in turn requires 2-Step
# Verification to be turned on first. To create one:
# https://myaccount.google.com/apppasswords
#
# MAIL_USERNAME MUST be the address of the Google account the App Password was
# issued to — not merely an address the salon is known by.
#
# That distinction cost a long afternoon here. An App Password authenticates
# exactly one account, so pairing it with any other address fails with
# `535-5.7.8 Username and Password not accepted` no matter how correct the
# password is, and the message points at the password rather than the username,
# which sends you off generating more passwords that cannot work either. If a
# send is rejected, check that the App Password came from the account named in
# MAIL_USERNAME before making a new one.
#
# Paste the 16-character App Password into MAIL_PASSWORD in `.env`, then run
# `php artisan config:clear`. It is left blank here on purpose: this file is
# committed, and a Gmail App Password is a live credential for a live mailbox.
#
# MAIL_FROM_ADDRESS may differ from MAIL_USERNAME only when the From address is a
# verified alias or "send as" address on the authenticated account. If it is not,
# Gmail rewrites the sender to the authenticated mailbox — so if the salon's
# public address should appear on customer emails, add it as an alias on that
# Google account rather than just setting it here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
# `tls` = STARTTLS on port 587, `ssl` = implicit TLS on port 465.
# Laravel 11 reads `scheme`, not `encryption`; config/mail.php maps this onto it.
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="rucielmaeobias277@gmail.com"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="balaitiarjud@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
