%% Entity-Relationship Diagram — Salon Booking & Inventory System
%% Format: Mermaid erDiagram. Import into draw.io via Arrange > Insert > Advanced >
%% Mermaid, or paste into https://mermaid.live and export as SVG, then drop into EdrawMax.
%%
%% Authoritative basis: the schema produced by `php artisan migrate` on a clean database.
%% Only the 18 business tables are drawn; the 6 Laravel framework tables (sessions,
%% password_reset_tokens, cache, cache_locks, jobs, job_batches, failed_jobs,
%% migrations) are omitted — add them only if your instructor asks for the full
%% physical model.

erDiagram

    %% ------------------------------------------------------------------
    %% IDENTITY & ACCESS
    %% ------------------------------------------------------------------
    USERS {
        bigint   id            PK "AI"
        varchar  first_name       "NOT NULL - PI"
        varchar  last_name        "NOT NULL - PI"
        varchar  email         UK "NOT NULL - PI"
        varchar  username       UK "varchar(64) - PI"
        varchar  contact_number   "varchar(32) NOT NULL - PI"
        varchar  password         "NOT NULL - SPI bcrypt"
        varchar  profile_photo_path "NULL - SPI image"
        boolean  is_active        "default 1"
        timestamp last_login_at   "NULL - PI"
        varchar  remember_token   "NULL"
        timestamp created_at      "NULL"
        timestamp updated_at      "NULL"
        timestamp deleted_at      "NULL - soft delete"
    }

    ADMINS {
        bigint   id            PK "AI"
        varchar  first_name       "NOT NULL - PI"
        varchar  last_name        "NOT NULL - PI"
        varchar  username       UK "varchar(64) - PI"
        varchar  email         UK "NOT NULL - PI"
        varchar  password         "NOT NULL - SPI bcrypt"
        enum     role             "SINGLE VALUE admin only"
        varchar  profile_photo_path "NULL"
        boolean  is_active        "default 1"
        timestamp last_login_at   "NULL"
        varchar  remember_token   "NULL"
        timestamp deleted_at      "NULL - soft delete"
    }

    %% ------------------------------------------------------------------
    %% CATALOGUE
    %% ------------------------------------------------------------------
    SERVICE_CATEGORIES {
        bigint   id            PK "AI"
        varchar  name         UK "NOT NULL"
        varchar  color           "varchar(7) default #7A241B"
        int      sort_order      "default 0"
        boolean  is_active       "default 1"
        varchar  photo           "NULL - categories/"
        timestamp created_at
        timestamp updated_at
    }

    SERVICES {
        bigint   id            PK "AI"
        varchar  name            "NOT NULL"
        varchar  slug         UK "NOT NULL"
        varchar  category        "IDX - legacy free text"
        bigint   service_category_id FK "NULL - SET NULL"
        varchar  price           "varchar(50) NULL - display text"
        decimal  base_price      "decimal(10,2) NULL - numeric"
        smallint duration_minutes "unsigned default 60"
        text     description      "NULL"
        varchar  photo_path       "NULL"
        boolean  is_active        "default 1"
        boolean  is_featured      "default 0"
        timestamp deleted_at      "NULL - soft delete"
    }

    SERVICE_VARIANTS {
        bigint   id            PK "AI"
        bigint   service_id    FK "NOT NULL - CASCADE"
        varchar  name            "NOT NULL - UK with service_id"
        varchar  price           "varchar(50) NULL - display text"
        decimal  base_price      "decimal(10,2) NULL - numeric"
        smallint duration_minutes "unsigned NULL"
        boolean  is_default      "default 0"
    }

    %% ------------------------------------------------------------------
    %% BOOKING
    %% ------------------------------------------------------------------
    APPOINTMENTS {
        bigint   id                 PK "AI"
        varchar  reference_number  UK "varchar(32)"
        bigint   user_id           FK "NULL - SET NULL - walk-ins allowed"
        varchar  customer_name       "NOT NULL - PI"
        varchar  customer_phone      "varchar(32) NOT NULL - PI"
        varchar  customer_email      "NULL - PI"
        date     preferred_date      "IDX"
        time     preferred_time      "IDX"
        text     allergies           "NULL - SPI HEALTH"
        text     last_services_availed "NULL - SPI history"
        bigint   preferred_stylist_id FK "NULL - SET NULL to ADMINS"
        bigint   technician_id       FK "NULL - SET NULL - no preference"
        text     special_request     "NULL - SPI"
        varchar  down_payment_reference "varchar(64) NULL - SPI financial"
        decimal  down_payment_amount "decimal(10,2) NULL - SPI financial"
        enum     down_payment_status "default unverified"
        decimal  total_amount        "decimal(12,2) default 0"
        enum     status              "default pending"
        varchar  source              "varchar(24) default web"
        text     admin_notes         "NULL - internal only"
        varchar  cancellation_reason "NULL - PI"
        varchar  reschedule_reason   "NULL - PI"
        timestamp admin_seen_at      "NULL - IDX"
        timestamp confirmed_at
        timestamp started_at
        timestamp completed_at
        timestamp cancelled_at
        timestamp archived_at
        bigint   archived_by       FK "NULL - SET NULL to ADMINS"
        timestamp deleted_at         "NULL - soft delete"
    }

    APPOINTMENT_SERVICE {
        bigint   id                PK "AI"
        bigint   appointment_id   FK "NOT NULL - CASCADE"
        bigint   service_id       FK "NULL - SET NULL"
        bigint   service_variant_id FK "NULL - SET NULL"
        varchar  service_name        "NOT NULL - snapshot"
        varchar  variant_name        "NULL - snapshot"
        decimal  price               "decimal(10,2) NOT NULL - snapshot"
        varchar  display_price       "varchar(50) NULL - snapshot text"
        smallint duration_minutes    "unsigned NOT NULL - snapshot"
        smallint quantity            "unsigned default 1"
    }

    APPOINTMENT_STATUS_HISTORY {
        bigint   id              PK "AI"
        bigint   appointment_id FK "NOT NULL - CASCADE"
        enum     from_status       "NULL on first entry"
        enum     to_status         "NOT NULL"
        enum     changed_by        "default system"
        bigint   changed_by_id     "NULL - deliberately NOT a FK"
        varchar  changed_by_name   "NULL - snapshot"
        text     note              "NULL"
    }

    TECHNICIANS {
        bigint   id          PK "AI"
        varchar  name           "varchar(120) NOT NULL - PI"
        varchar  photo_path      "NULL"
        boolean  is_active       "default 1"
        timestamp deleted_at      "NULL - soft delete"
    }

    %% ------------------------------------------------------------------
    %% INVENTORY
    %% ------------------------------------------------------------------
    INVENTORY_ITEMS {
        bigint   id                PK "AI"
        varchar  name                "NOT NULL"
        varchar  sku              UK "varchar(64)"
        varchar  category            "IDX"
        decimal  quantity            "decimal(12,2) default 0"
        varchar  unit                "varchar(24) default pcs"
        decimal  reorder_threshold   "decimal(12,2) NULL"
        date     date_in             "NULL"
        date     expiry_date         "NULL"
        varchar  supplier            "NULL"
        enum     status_tag          "default available"
        text     notes               "NULL"
        boolean  is_active           "default 1"
        timestamp deleted_at         "NULL - soft delete"
    }

    SERVICE_INVENTORY {
        bigint   id                   PK "AI"
        bigint   service_id          FK "NOT NULL - CASCADE"
        bigint   inventory_item_id   FK "NOT NULL - CASCADE"
        decimal  quantity_per_service "decimal(12,2) default 1"
    }

    %% ------------------------------------------------------------------
    %% CONTENT & COMMUNICATION
    %% ------------------------------------------------------------------
    PROMOS {
        bigint   id            PK "AI"
        varchar  title           "NOT NULL"
        text     description     "NOT NULL - full text"
        date     starts_at       "IDX"
        date     ends_at         "IDX"
        varchar  image_path      "NULL - promos/"
        boolean  is_active       "default 1"
        boolean  notified        "default 0"
        timestamp deleted_at      "NULL - soft delete"
    }

    TERMS_AND_CONDITIONS {
        bigint   id            PK "AI"
        enum     category        "booking/cancellation/rescheduling - UK with version"
        int      version         "unsigned - UK with category"
        longtext content          "NOT NULL - admin rich text"
        boolean  is_published    "default 0"
        timestamp published_at   "NULL"
        bigint   created_by    FK "NULL - SET NULL to ADMINS"
    }

    CONTACT_MESSAGES {
        bigint   id          PK "AI"
        varchar  name          "NOT NULL - PI"
        varchar  email         "NOT NULL - PI"
        enum     topic         "7 values - IDX"
        text     message       "NOT NULL - PI may contain SPI"
        boolean  is_read       "default 0"
        text     admin_reply   "NULL"
        timestamp replied_at    "NULL"
    }

    SALON_SETTINGS {
        bigint   id                    PK "AI"
        varchar  name                     "default per shop"
        varchar  address                 "NULL"
        varchar  phone                    "varchar(32) NULL"
        varchar  email                    "NULL"
        json     operating_hours           "closed days simply absent"
        smallint slot_interval_minutes    "unsigned default 30"
        smallint booking_lead_days         "unsigned default 60"
        boolean  down_payment_required     "default 1"
        tinyint  down_payment_percentage   "unsigned default 50"
    }

    PASSWORD_RESET_CODES {
        bigint   id          PK "AI"
        varchar  email         "IDX - PI"
        varchar  code_hash     "NOT NULL - bcrypt of the code"
        timestamp expires_at   "IDX"
        timestamp used_at      "NULL - single use"
        tinyint  attempts       "default 0"
        varchar  ip_address     "varchar(45) NULL - PI"
    }

    NOTIFICATIONS {
        uuid    id             PK
        varchar  type            "NOT NULL"
        varchar  notifiable_type "IDX - polymorphic"
        bigint   notifiable_id   "IDX - polymorphic, NOT a FK"
        text     data            "JSON payload"
        timestamp read_at         "NULL"
    }

    %% ------------------------------------------------------------------
    %% RELATIONSHIPS
    %% ------------------------------------------------------------------
    %% PROMOS, SALON_SETTINGS, CONTACT_MESSAGES, PASSWORD_RESET_CODES and
    %% NOTIFICATIONS are declared above and deliberately carry no relationship
    %% arrows: they are standalone stores with no foreign key to any other table.
    %% (NOTIFICATIONS points at a notifiable polymorphically, which is not a
    %% drawable FK.)

    %% A customer may place many bookings; a booking may be a walk-in (no user).
    USERS ||--o{ APPOINTMENTS : "places (SET NULL on delete)"

    %% Historical references to staff. Both survive deletion.
    ADMINS ||--o{ APPOINTMENTS : "preferred stylist (SET NULL)"
    ADMINS ||--o{ APPOINTMENTS : "archived by (SET NULL)"
    ADMINS ||--o{ TERMS_AND_CONDITIONS : "authors (SET NULL)"

    %% The person the customer actually asked for.
    TECHNICIANS ||--o{ APPOINTMENTS : "performs (SET NULL)"

    %% Composition - a booking cannot exist without its lines.
    APPOINTMENTS ||--|{ APPOINTMENT_SERVICE : "contains (CASCADE)"
    APPOINTMENTS ||--o{ APPOINTMENT_STATUS_HISTORY : "audited by (CASCADE)"

    %% Snapshotted catalogue references - history must not rewrite itself.
    SERVICES ||--o{ APPOINTMENT_SERVICE : "was booked as (SET NULL)"
    SERVICE_VARIANTS ||--o{ APPOINTMENT_SERVICE : "was chosen as (SET NULL)"

    %% Catalogue structure.
    SERVICE_CATEGORIES ||--o{ SERVICES : "classifies (SET NULL)"
    SERVICES ||--o{ SERVICE_VARIANTS : "offers (CASCADE)"

    %% Many-to-many via an explicit junction carrying its own attribute.
    SERVICES ||--o{ SERVICE_INVENTORY : "consumes"
    INVENTORY_ITEMS ||--o{ SERVICE_INVENTORY : "is used by"
